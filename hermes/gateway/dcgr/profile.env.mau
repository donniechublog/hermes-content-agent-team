# Mau .env cho MOI profile dcgr (~/.hermes-dcgr/profiles/<vai>/.env, chmod 600).
# Multiplex doc bi mat theo profile, KHONG fallback .env goc -> thieu la chat bi tu choi.
# KHONG dat TELEGRAM_BOT_TOKEN / TELEGRAM_HOME_CHANNEL o day: gateway se coi moi profile
# la mot adapter Telegram rieng cung token va tu choi ca 8 ("same credential", 05/09/2026).
OPENAI_API_KEY=<virtual key 9router, giong .env goc>
TELEGRAM_ALLOWED_USERS=<id Ong Chu, giong .env goc>
